---
import type { SectionOf } from '../schemas/sections';
import SectionShell from '../primitives/SectionShell.astro';
import SectionHeading from '../primitives/SectionHeading.astro';
import ProductWindow, { type ResolvedMedia } from '../components/ProductWindow.astro';
import Button from '../primitives/Button.astro';
import Icon from '../primitives/Icon.astro';
import CheckList from '../primitives/CheckList.astro';

type Tab = Omit<SectionOf<'tabbedShowcase'>['tabs'][number], 'media'> & { media: ResolvedMedia };
type Props = Omit<SectionOf<'tabbedShowcase'>, 'type' | 'tabs'> & { uid: string; tabs: Tab[] };

const { uid, icon, anchor, title, titleAccent, lede, band, tabs } = Astro.props;
const id = `${uid}-title`;
---

<SectionShell labelledBy={id} band={band} anchor={anchor}>
  <SectionHeading id={id} icon={icon} title={title} titleAccent={titleAccent} lede={lede} />
  <div class="showcase" data-tabs>
    <div class="tablist" role="tablist" aria-labelledby={id}>
      {tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`${uid}-tab-${i}`}
          aria-controls={`${uid}-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {tab.icon && <Icon name={tab.icon} size={16} />}
          {tab.label}
        </button>
      ))}
    </div>
    {tabs.map((tab, i) => (
      <div
        class="panel"
        role="tabpanel"
        id={`${uid}-panel-${i}`}
        aria-labelledby={`${uid}-tab-${i}`}
        data-tab-panel
        data-active={i === 0 ? 'true' : 'false'}
      >
        <div class="copy">
          <h3>{tab.title}</h3>
          <p>{tab.body}</p>
          <CheckList items={tab.bullets} />
          {tab.link && (
            <Button href={tab.link.href} variant={tab.link.variant}>
              {tab.link.label}
            </Button>
          )}
        </div>
        <ProductWindow media={tab.media} />
      </div>
    ))}
  </div>
</SectionShell>

<script>
  // WAI-ARIA tabs: click or arrow keys switch panels. Without JS every panel stays visible,
  // so all content is in the HTML for search and answer engines.
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    root.dataset.enhanced = 'true';
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>(':scope > [data-tab-panel]')];
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i]!.dataset.active = String(on);
      });
      if (focus) tabs[index]!.focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const next = {
          ArrowRight: i === last ? 0 : i + 1,
          ArrowLeft: i === 0 ? last : i - 1,
          Home: 0,
          End: last,
        }[e.key];
        if (next !== undefined) {
          e.preventDefault();
          select(next, true);
        }
      });
    });
  }
</script>

<style>
  .showcase {
    display: grid;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }

  .tablist {
    display: none;
  }

  [data-enhanced] .tablist {
    display: flex;
    justify-self: center;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
    gap: 2px;
    padding: 3px;
    border-radius: 10px;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid transparent;
    box-shadow: var(--glass-shadow);
  }

  [role='tab'] {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex: none;
    padding: 8px 14px;
    border: 0;
    border-radius: 8px;
    background: none;
    font-size: var(--fs-small);
    color: var(--text);
    cursor: pointer;
  }

  [role='tab'][aria-selected='true'] {
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 1px 2px rgb(28 28 30 / 0.08);
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--space-7);
    align-items: center;
  }

  .panel + .panel {
    margin-top: var(--space-8);
  }

  [data-enhanced] .panel + .panel {
    margin-top: 0;
  }

  [data-enhanced] .panel[data-active='false'] {
    display: none;
  }

  .copy {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  h3 {
    font-size: clamp(24px, 2.6vw, 30px);
  }

  p {
    max-width: 46ch;
  }

  @media (max-width: 960px) {
    .panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
