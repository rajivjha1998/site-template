---
import type { Section } from '../schemas/sections';
import { resolveForm, resolveMedia, type RenderContext } from '../lib/resolve';
import Hero from './Hero.astro';
import LogoStrip from './LogoStrip.astro';
import StatStrip from './StatStrip.astro';
import FeatureGrid from './FeatureGrid.astro';
import TabbedShowcase from './TabbedShowcase.astro';
import Split from './Split.astro';
import Steps from './Steps.astro';
import ComparisonTable from './ComparisonTable.astro';
import PricingTable from './PricingTable.astro';
import Testimonial from './Testimonial.astro';
import PageCards from './PageCards.astro';
import TierLadder from './TierLadder.astro';
import Faq from './Faq.astro';
import CtaPanel from './CtaPanel.astro';
import FormSection from './FormSection.astro';

interface Props {
  sections: Section[];
  context: RenderContext;
}

const { sections, context } = Astro.props;
---

{sections.map((section, index) => {
  const uid = `s${index}`;
  switch (section.type) {
    case 'hero': {
      const { type: _t, media, ...rest } = section;
      return (
        <Hero
          uid={uid}
          {...rest}
          media={media && resolveMedia(media, context)}
          captureForm={rest.capture && resolveForm(rest.capture.form, context)}
          formsOrigin={context.formsOrigin}
        />
      );
    }
    case 'logoStrip': {
      const { type: _t, ...rest } = section;
      return <LogoStrip uid={uid} {...rest} />;
    }
    case 'statStrip': {
      const { type: _t, ...rest } = section;
      return <StatStrip uid={uid} {...rest} />;
    }
    case 'featureGrid': {
      const { type: _t, ...rest } = section;
      return <FeatureGrid uid={uid} {...rest} />;
    }
    case 'tabbedShowcase': {
      const { type: _t, tabs, ...rest } = section;
      return (
        <TabbedShowcase
          uid={uid}
          {...rest}
          tabs={tabs.map((tab) => ({ ...tab, media: resolveMedia(tab.media, context) }))}
        />
      );
    }
    case 'split': {
      const { type: _t, media, ...rest } = section;
      return <Split uid={uid} {...rest} media={media && resolveMedia(media, context)} />;
    }
    case 'steps': {
      const { type: _t, ...rest } = section;
      return <Steps uid={uid} {...rest} />;
    }
    case 'comparisonTable': {
      const { type: _t, ...rest } = section;
      return <ComparisonTable uid={uid} {...rest} />;
    }
    case 'pricingTable': {
      const { type: _t, ...rest } = section;
      return <PricingTable uid={uid} {...rest} />;
    }
    case 'testimonial': {
      const { type: _t, ...rest } = section;
      return <Testimonial uid={uid} {...rest} />;
    }
    case 'pageCards': {
      const { type: _t, ...rest } = section;
      return (
        <PageCards uid={uid} {...rest} cards={context.cards} currentPath={context.currentPath} />
      );
    }
    case 'tierLadder': {
      const { type: _t, ...rest } = section;
      return <TierLadder uid={uid} {...rest} />;
    }
    case 'faq': {
      const { type: _t, ...rest } = section;
      return <Faq uid={uid} {...rest} />;
    }
    case 'ctaPanel': {
      const { type: _t, ...rest } = section;
      return (
        <CtaPanel
          uid={uid}
          {...rest}
          captureForm={rest.capture && resolveForm(rest.capture.form, context)}
          formsOrigin={context.formsOrigin}
        />
      );
    }
    case 'form': {
      const { type: _t, form, media, ...rest } = section;
      return (
        <FormSection
          uid={uid}
          {...rest}
          form={resolveForm(form, context)}
          media={media && resolveMedia(media, context)}
          turnstileSiteKey={context.turnstileSiteKey}
          formsOrigin={context.formsOrigin}
        />
      );
    }
    default: {
      const unknown: never = section;
      throw new Error(`No component for section ${JSON.stringify(unknown)}`);
    }
  }
})}
