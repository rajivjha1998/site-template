---
import type { SectionOf } from '../schemas/sections';

type Props = Omit<SectionOf<'testimonial'>, 'type'> & { uid: string };
const { uid, band = 'accent', quote, name, role } = Astro.props;
const id = `${uid}-quote`;
---

<section class:list={['band', `band-${band}`]} aria-labelledby={id}>
  <figure>
    <span class="mark" aria-hidden="true">
      “
    </span>
    <blockquote id={id}>
      <p>{quote}</p>
    </blockquote>
    <figcaption>
      <span class="name">{name}</span>
      <span class="role">{role}</span>
    </figcaption>
  </figure>
</section>

<style>
  .band {
    padding: var(--space-8) var(--gutter);
  }

  .band-accent {
    background: color-mix(in srgb, var(--accent-bg) 60%, transparent);
  }

  .band-surface {
    background: var(--band-tint);
  }

  figure {
    display: grid;
    gap: var(--space-4);
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-7);
    border-radius: 22px;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid transparent;
    box-shadow: var(--glass-shadow);
  }

  .mark {
    height: 32px;
    font-family: var(--font-display);
    font-size: 56px;
    line-height: 1;
    color: var(--accent);
  }

  blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(21px, 2.4vw, 26px);
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    font-size: var(--fs-small);
  }

  .name {
    color: var(--ink);
  }

  .role {
    color: var(--muted);
  }

  @media (max-width: 760px) {
    figure {
      padding: var(--space-5);
    }
  }
</style>
