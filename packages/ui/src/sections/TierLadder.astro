---
import type { SectionOf } from '../schemas/sections';
import SectionShell from '../primitives/SectionShell.astro';
import SectionHeading from '../primitives/SectionHeading.astro';
import CheckList from '../primitives/CheckList.astro';

type Props = Omit<SectionOf<'tierLadder'>, 'type'> & { uid: string };
const { uid, icon, anchor, title, titleAccent, lede, band, tiers } = Astro.props;
const id = `${uid}-title`;
---

<SectionShell labelledBy={id} band={band} anchor={anchor}>
  <SectionHeading id={id} icon={icon} title={title} titleAccent={titleAccent} lede={lede} />
  <ol class="ladder" style={`--n: ${tiers.length}`}>
    {tiers.map((tier, i) => (
      <li style={`--step: ${i}`}>
        <h3>{tier.name}</h3>
        <p class="req">{tier.requirement}</p>
        <CheckList items={tier.benefits} size="sm" />
      </li>
    ))}
  </ol>
</SectionShell>

<style>
  /* Each tier sits a step higher than the last, so the ladder reads as progression. */
  .ladder {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    align-items: end;
    gap: var(--space-4);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .ladder > li {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    min-height: calc(220px + var(--step) * 40px);
    padding: var(--space-5);
    border-radius: var(--r-card);
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border: 1px solid transparent;
    box-shadow: var(--glass-shadow);
  }

  .ladder > li:last-child {
    border-color: var(--accent-text);
  }

  h3 {
    font-size: 22px;
  }

  .req {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--accent-text);
  }

  @media (max-width: 960px) {
    .ladder {
      grid-template-columns: minmax(0, 1fr);
    }

    .ladder > li {
      min-height: 0;
    }
  }
</style>
